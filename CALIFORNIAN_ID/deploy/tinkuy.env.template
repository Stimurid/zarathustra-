# /etc/tinkuy/tinkuy.env — заполнить и chmod 600
#
# ============================================================
# LLM провайдер
# ============================================================
# Дефолт mock — Zarathustra отвечает шаблонно, форма и структура правильные.
# Для содержательной работы:
#   CALIFORNIAN_ID_PROVIDER=302ai
#   API_302AI_KEY=sk-...
# либо:
#   CALIFORNIAN_ID_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...

CALIFORNIAN_ID_PROVIDER=mock

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# API_302AI_KEY=sk-...

# ============================================================
# Runs directory
# ============================================================
# Куда пишутся runs/, workspaces/*, fabric.sqlite3, narrative.sqlite3,
# users.sqlite3, jwt.secret. На проде unit уже проставляет /srv/tinkuy/runs.
# CALIFORNIAN_ID_RUNS_DIR=/srv/tinkuy/runs

# ============================================================
# Auth (Пик 8.3 multi-key + Пик 6.4 JWT)
# ============================================================
# Приоритет проверки Bearer в _compat_key_is_valid:
#   1. CALIFORNIAN_ID_AUTH_DISABLED=1 — пропуск (только dev).
#   2. Bearer выглядит как JWT — verify через users.sqlite3 + jwt.secret.
#   3. Bearer в CALIFORNIAN_ID_API_KEYS — статические ключи с labels.
#   4. Legacy TINKUY_COMPAT_API_KEY — единственный ключ.
#
# Multi-key (label используется в rate-limit + billing):
# CALIFORNIAN_ID_API_KEYS=k1:alice,k2:bob

# JWT — секрет автогенерируется в RUNS_DIR/jwt.secret если не задан.
# Явно задать для стабильности между инстансами:
# CALIFORNIAN_ID_JWT_SECRET=<64+ base64url random bytes>

# Legacy compat (только если не используешь multi-key/JWT):
# TINKUY_COMPAT_API_KEY=tk-...

# ============================================================
# Rate limiting (Пик 8.3)
# ============================================================
# CALIFORNIAN_ID_RATE_LIMIT_PER_MIN=30

# ============================================================
# Cost budgets (Пик 9.2)
# ============================================================
# Путь к yaml-файлу с per-workspace лимитами:
#   default:
#     soft: 100
#     hard: 1000
# CALIFORNIAN_ID_BUDGETS_YAML=/etc/tinkuy/budgets.yaml
# CALIFORNIAN_ID_BUDGETS_DISABLED=1  # выключить enforcement
