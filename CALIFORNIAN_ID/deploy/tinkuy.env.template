# /etc/tinkuy/tinkuy.env — заполнить и chmod 600
#
# Провайдер LLM. Дефолт mock — Zarathustra будет отвечать шаблонно,
# но форма и структура правильные. Для содержательной работы:
#   CALIFORNIAN_ID_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...

CALIFORNIAN_ID_PROVIDER=mock

# Dedicated Tinkuy-issued key for the local OpenAI-compatible endpoint.
# Generate a fresh value per deployment, never reuse upstream provider keys.
# TINKUY_COMPAT_API_KEY=tk-...

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
