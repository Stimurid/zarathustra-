{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy/californian_id/dispute_assessment.schema.json",
  "title": "DisputeAssessment",
  "type": "object",
  "required": ["dispute_mode", "thesis_preserved", "continue_or_stop", "confidence"],
  "properties": {
    "dispute_mode": {"type": "string", "enum": ["truth", "persuasion", "victory"]},
    "thesis_preserved": {"type": "boolean"},
    "thesis_snapshot": {"type": "string"},
    "burden_state": {
      "type": "object",
      "properties": {
        "who_carries_burden": {"type": "string"},
        "whether_shifted": {"type": "boolean"},
        "shift_reason": {"type": "string"}
      }
    },
    "valid_attack": {"type": "boolean"},
    "valid_defence": {"type": "boolean"},
    "fallacies_or_tricks": {"type": "array", "items": {"type": "string"}},
    "fairness_events": {"type": "array", "items": {"type": "string"}},
    "required_response_type": {"type": "string", "enum": ["attack", "defence", "restore_ground", "refuse", "stop", "any"]},
    "continue_or_stop": {"type": "string", "enum": ["continue", "stop"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
