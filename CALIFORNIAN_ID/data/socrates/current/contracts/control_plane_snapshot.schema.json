{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy.local/socrates/gs25/control_plane_snapshot.schema.json",
  "title": "Control Plane Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status_owners",
    "governing_specifications",
    "claim_owners",
    "anchors",
