{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy.local/socrates/gs25/prompt_module_contract.schema.json",
  "title": "Prompt Module Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "purpose",
    "input_contract_refs",
    "output_contract_refs",
    "critical_invariant_refs",
    "prompt_only_critical_invariant",
    "file"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "input_contract_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "output_contract_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "critical_invariant_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "prompt_only_critical_invariant": {
      "const": false
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "user_visible_output_allowed": {
      "type": "boolean"
    }
  }
}
