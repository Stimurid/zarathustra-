{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy.local/socrates/gs26/epistemic_space.schema.json",
  "title": "EpistemicSpace",
  "description": "G-BD.2 addressable epistemic jurisdiction. A Space is NOT an ontology id (many-to-many via mounts). Lexical mention has ZERO Space activation authority. Space cannot override Constitution / origin / status / human ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": ["space_id", "version", "name"],
  "properties": {
    "space_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "telos_scope": {"type": "string"},
    "world_model_mounts": {
      "type": "array",
      "items": {"$ref": "world_model_mount.schema.json"}
    },
    "ontology_refs": {"type": "array", "items": {"type": "string"}},
    "proof_regime": {"type": "string"},
    "claim_status_policy": {"type": "string"},
    "allowed_operation_families": {"type": "array", "items": {"type": "string"}},
    "operator_capabilities": {"type": "array", "items": {"type": "string"}},
    "corpus_namespaces": {"type": "array", "items": {"type": "string"}},
    "retrieval_policy": {"type": "string"},
    "memory_default_scope": {
      "enum": ["GLOBAL_SELF", "GLOBAL_BETWEEN", "PROJECT",
                "SPACE_OR_DOMAIN", "SCENE", "BRANCH", "PROJECTION",
                "INSTRUMENT", "ARCHIVAL_ONLY"]
    },
    "memory_recruitment_policy": {"type": "string"},
    "authority_refs": {"type": "array", "items": {"type": "string"}},
    "transition_policy": {"type": "string"},
    "provenance": {"type": "string"},
    "activation_scope": {"type": "string"},
    "lineage": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "string"},
    "status": {"type": "string"}
  }
}
