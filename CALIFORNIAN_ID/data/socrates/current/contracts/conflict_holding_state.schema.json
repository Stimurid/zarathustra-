{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy.local/socrates/gs26/conflict_holding_state.schema.json",
  "title": "ConflictHoldingState",
  "description": "Typed record that the runtime is holding a real incompatibility without forced synthesis. B09 may arbitrate ACTION from this state; B09 does NOT vote TRUTH.",
  "type": "object",
  "additionalProperties": false,
  "required": ["conflict_id", "family", "handling_mode"],
  "properties": {
    "conflict_id": {"type": "string", "minLength": 1},
    "family": {
      "enum": ["ONTOLOGY", "EPISTEMIC_STATUS", "AUTHORITY",
                "OPERATION", "VALUE", "CAUSAL_GRAMMAR",
                "IDENTITY_RULE", "MEMORY_FORCE"]
    },
    "handling_mode": {
      "enum": ["LOCALIZE", "HOLD", "TRANSLATE", "TRANSDUCE",
                "ARBITRATE_ACTION", "SUSPEND", "REJECT"]
    },
    "parties": {"type": "array", "items": {"type": "string"}},
    "subject_refs": {"type": "array", "items": {"type": "string"}},
    "space_ids": {"type": "array", "items": {"type": "string"}},
    "scene_ids": {"type": "array", "items": {"type": "string"}},
    "branch_ids": {"type": "array", "items": {"type": "string"}},
    "projection_ids": {"type": "array", "items": {"type": "string"}},
    "description": {"type": "string"},
    "discriminating_evidence_required": {
      "type": "array", "items": {"type": "string"}
    },
    "review_trigger": {"type": "string"},
    "action_arbitration": {"type": "string"},
    "status": {"type": "string"}
  }
}
