{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy.local/socrates/gs26/generated_cutter_spec.schema.json",
  "title": "GeneratedCutterSpec",
  "description": "ADR-S26-023 declarative CutterSpec synthesised when no registered CutterCapability fits. UNPRIVILEGED DATA — carrying this record grants no execution authority beyond the primitives it composes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id", "version", "source_id", "operation_id",
    "ontology_id", "target_object_family", "segmentation_policy",
    "primitives"
  ],
  "properties": {
    "spec_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "scene_ref": {"type": "string"},
    "operation_id": {"type": "string", "minLength": 1},
    "ontology_id": {"type": "string", "minLength": 1},
    "target_object_family": {
      "type": "array", "items": {"type": "string"}, "minItems": 1
    },
    "recognition_criteria": {"type": "array", "items": {"type": "string"}},
    "segmentation_policy": {"type": "string", "minLength": 1},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "contraindications": {"type": "array", "items": {"type": "string"}},
    "applicability_assumptions": {"type": "array", "items": {"type": "string"}},
    "primitives": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "primitive_id"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "primitive_id": {"type": "string", "minLength": 1},
          "params": {"type": "object"},
          "inputs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "accepted_output": {"type": "string"},
    "residue_output": {"type": "string"},
    "parent_projection_id": {"type": "string"},
    "revises": {"type": "string"},
    "status": {"enum": ["exploratory", "accepted_local",
                        "partial", "rejected"]},
    "fingerprint": {"type": "string"}
  }
}
