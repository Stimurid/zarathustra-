{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy.local/schemas/persona-retrieval-card.schema.json",
  "title": "Tinkuy Persona Retrieval Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "persona_id",
    "card_type",
    "title",
    "statement",
    "grounds",
    "source_refs",
    "operation_hint",
    "operation_id_exact",
    "operation_mapping",
    "activation_conditions",
    "contraindications",
    "expected_body_delta",
    "retrieval_namespace",
    "retrieval_text",
    "provenance_status",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "card_id": {
      "type": "string",
      "minLength": 3
    },
    "persona_id": {
      "enum": [
        "C",
        "T",
        "Ex",
        "S",
        "R",
        "EA",
        "L"
      ]
    },
    "card_type": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "grounds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locator",
          "provenance_status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "provenance_status": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "work": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_or_secondary": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "operation_hint": {
      "type": "string"
    },
    "operation_id_exact": {
      "type": "string",
      "pattern": "^(C|T|EX|S|R|EA|L)-OP[0-9]{2}$"
    },
    "secondary_operation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operation_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence",
        "review_status"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "enum": [
            "approved",
            "degraded",
            "needs_review"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "activation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contraindications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_body_delta": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "internal_opponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieval_namespace": {
      "type": "string"
    },
    "retrieval_text": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "provenance_status": {
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "degraded_candidate"
      ]
    },
    "source_generation": {
      "type": "string"
    }
  }
}