        "reason": {
          "type": "string"
        },
        "why_seven_are_insufficient_here": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "perception": {
      "type": "object",
      "required": [
        "what_is_happening",
        "current_scene_unit",
        "hidden_scene",
        "affected_subjects",
        "absent_or_xeno_participants",
