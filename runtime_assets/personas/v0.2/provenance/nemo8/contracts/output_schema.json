      "type": "object",
      "required": [
        "id",
        "reason",
        "why_seven_are_insufficient_here"
      ],
      "properties": {
        "id": {
          "enum": [
            "AFTER_VICTORY",
            "AFTER_DEFEAT",
            "AFTER_STALEMATE",
            "FALSE_SYNTHESIS",
            "HUMAN_FRAME_EXHAUSTED",
            "ADDRESS_COLLAPSE",
            "POWER_MANDATE_COLLAPSE",
            "TRANSLATION_LOSS",
            "FUTURE_BLACKMAIL",
            "CRITIQUE_WITHOUT_DELTA",
            "MODE_CHANGE_REQUIRED",
            "DIRECT_CALL"
          ]
