{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkuy.local/schemas/n8-output-v0.2.schema.json",
  "title": "N8 Structured Response v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "persona_id",
    "entry_gate",
    "perception",
    "distinction",
    "position",
    "intervention",
    "argument_delta",
    "body_delta",
    "residue",
    "self_critique",
    "provenance",
    "exit",
    "ownership_check",
    "countercanon_check"
